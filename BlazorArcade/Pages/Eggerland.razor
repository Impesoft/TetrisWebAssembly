@page "/Eggerland"
@namespace BlazorArcade.Pages

<video muted loop id="bg">
    <source src="./css/BGTunnel.mp4" type="video/mp4" />
</video>

<div class="controls">
    <button @onclick="@(() => _nav.NavigateTo("/"))">🏠 Home</button>
    <button @onclick="RestartStage">🔄 Restart (R)</button>
    <button @onclick="UndoMove" disabled="@(!GameInstance.CanUndo)">↩️ Undo (U)</button>
    
    <div class="level-select-container">
        <label for="levelSelect">Stage: </label>
        <select id="levelSelect" @onchange="SelectLevel" value="@GameInstance.CurrentLevelIndex">
            @for (int i = 0; i < GameInstance.TotalLevels; i++)
            {
                <option value="@i">Stage @(i + 1)</option>
            }
        </select>
    </div>
</div>

<div class="eggerland-container" tabindex="0"
     @onkeydown="HandleKeyDown"
     @onkeyup="HandleKeyUp"
     @ref="GameContainer">

    <!-- Top Status Bar -->
    <div class="stats-container">
        <div class="stat-item"><span class="stat-label">STAGE</span> <span class="stat-val">@(GameInstance.CurrentLevelIndex + 1)</span></div>
        <div class="stat-item"><span class="stat-label">SCORE</span> <span class="stat-val">@GameInstance.Score</span></div>
        <div class="stat-item"><span class="stat-label">HEARTS</span> <span class="stat-val">❤️ @GameInstance.HeartsRemaining</span></div>
        <div class="stat-item"><span class="stat-label">SHOTS</span> <span class="stat-val">⚡ @GameInstance.Player.Shots</span></div>
        <div class="stat-item"><span class="stat-label">LIVES</span> <span class="stat-val">🥚 @GameInstance.Lives</span></div>
    </div>

    @if (GameInstance.IsGameOver)
    {
        <div class="game-message">
            <h2>Game Over!</h2>
            <button @onclick="StartGame">Play Again</button>
        </div>
    }
    else if (GameInstance.IsGameWon)
    {
        <div class="game-message">
            <h2>🎉 Congratulations!</h2>
            <p>You solved all stages of Eggerland!</p>
            <button @onclick="StartGame">Play Again</button>
        </div>
    }

    <div class="stage-title">@GameInstance.CurrentLevelName</div>

    <!-- Main Game Board -->
    <svg class="eggerland-board" xmlns="http://www.w3.org/2000/svg"
         viewBox="0 0 @(BlazorArcade.GameLogic.EggerlandGame.Width * 40) @(BlazorArcade.GameLogic.EggerlandGame.Height * 40)">

        <defs>
            <radialGradient id="lolo-grad" cx="35%" cy="35%" r="65%">
                <stop offset="0%" stop-color="#70d6ff" />
                <stop offset="60%" stop-color="#0077b6" />
                <stop offset="100%" stop-color="#03045e" />
            </radialGradient>

            <radialGradient id="heart-grad">
                <stop offset="0%" stop-color="#ff758f" />
                <stop offset="100%" stop-color="#c9184a" />
            </radialGradient>

            <linearGradient id="block-grad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#52b788" />
                <stop offset="100%" stop-color="#1b4332" />
            </linearGradient>

            <radialGradient id="medusa-gaze" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="rgba(255, 0, 0, 0.4)" />
                <stop offset="100%" stop-color="rgba(255, 0, 0, 0.0)" />
            </radialGradient>
        </defs>

        <!-- 1. Tile Map Layer -->
        @for (int y = 0; y < BlazorArcade.GameLogic.EggerlandGame.Height; y++)
        {
            @for (int x = 0; x < BlazorArcade.GameLogic.EggerlandGame.Width; x++)
            {
                var tile = GameInstance.Map[x, y];
                double px = x * 40;
                double py = y * 40;

                <!-- Base Floor -->
                <rect x="@px" y="@py" width="40" height="40" fill="#1b263b" stroke="#0d1b2a" stroke-width="1" />

                if (tile == BlazorArcade.GameLogic.EggerlandTileType.Tree)
                {
                    <!-- Tree -->
                    <circle cx="@(px + 20)" cy="@(py + 18)" r="14" fill="#2d6a4f" />
                    <circle cx="@(px + 14)" cy="@(py + 22)" r="10" fill="#40916c" />
                    <circle cx="@(px + 26)" cy="@(py + 22)" r="10" fill="#40916c" />
                    <rect x="@(px + 18)" y="@(py + 28)" width="4" height="10" fill="#523a28" />
                }
                else if (tile == BlazorArcade.GameLogic.EggerlandTileType.Water)
                {
                    <!-- Water -->
                    <rect x="@px" y="@py" width="40" height="40" fill="#0077b6" />
                    <path d="M @px @(py+10) Q @(px+10) @(py+5) @(px+20) @(py+10) T @(px+40) @(py+10)" fill="none" stroke="#90e0ef" stroke-width="2" opacity="0.6" />
                    <path d="M @px @(py+25) Q @(px+10) @(py+20) @(px+20) @(py+25) T @(px+40) @(py+25)" fill="none" stroke="#90e0ef" stroke-width="2" opacity="0.6" />
                }
                else if (tile == BlazorArcade.GameLogic.EggerlandTileType.ArrowUp ||
                         tile == BlazorArcade.GameLogic.EggerlandTileType.ArrowDown ||
                         tile == BlazorArcade.GameLogic.EggerlandTileType.ArrowLeft ||
                         tile == BlazorArcade.GameLogic.EggerlandTileType.ArrowRight)
                {
                    <!-- One Way Arrow -->
                    <rect x="@px" y="@py" width="40" height="40" fill="#3d5a80" />
                    string arrowSymbol = tile switch {
                        BlazorArcade.GameLogic.EggerlandTileType.ArrowUp => "▲",
                        BlazorArcade.GameLogic.EggerlandTileType.ArrowDown => "▼",
                        BlazorArcade.GameLogic.EggerlandTileType.ArrowLeft => "◀",
                        _ => "▶"
                    };
                    <g><text x="@(px + 20)" y="@(py + 26)" fill="#e0fbfc" font-size="20" font-weight="bold" text-anchor="middle">@arrowSymbol</text></g>
                }
                else if (tile == BlazorArcade.GameLogic.EggerlandTileType.HeartFrame)
                {
                    <!-- Heart Frame -->
                    <rect x="@(px + 4)" y="@(py + 4)" width="32" height="32" rx="6" fill="#ffb703" stroke="#fb8500" stroke-width="2" />
                    <path d="M @(px+20) @(py+28) C @(px+8) @(py+18) @(px+12) @(py+10) @(px+20) @(py+16) C @(px+28) @(py+10) @(px+32) @(py+18) @(px+20) @(py+28) Z" fill="url(#heart-grad)" />
                }
                else if (tile == BlazorArcade.GameLogic.EggerlandTileType.JewelChest)
                {
                    <!-- Jewel Chest -->
                    <rect x="@(px + 4)" y="@(py + 8)" width="32" height="26" rx="4" fill="#fb8500" stroke="#ffb703" stroke-width="2" />
                    <line x1="@(px+4)" y1="@(py+16)" x2="@(px+36)" y2="@(py+16)" stroke="#d4a373" stroke-width="2" />
                    @if (GameInstance.IsChestOpen)
                    {
                        <!-- Open Chest with Glowing Blue Jewel -->
                        <polygon points="@(px+20),@(py+10) @(px+26),@(py+16) @(px+20),@(py+24) @(px+14),@(py+16)" fill="#00f5d4" stroke="#ffffff" stroke-width="1.5" />
                    }
                    else
                    {
                        <!-- Keyhole -->
                        <circle cx="@(px + 20)" cy="@(py + 21)" r="3" fill="#000" />
                    }
                }
                else if (tile == BlazorArcade.GameLogic.EggerlandTileType.ExitDoor)
                {
                    <!-- Exit Door -->
                    <rect x="@(px + 4)" y="@(py + 2)" width="32" height="36" rx="16" fill="@(GameInstance.IsExitOpen ? "#00f5d4" : "#4a4e69")" stroke="#f2e9e4" stroke-width="2" />
                    @if (GameInstance.IsExitOpen)
                    {
                        <g><text x="@(px + 20)" y="@(py + 25)" fill="#000" font-weight="bold" font-size="14" text-anchor="middle">EXIT</text></g>
                    }
                }
            }
        }

        <!-- Outer Border Wall -->
        <rect x="0" y="0" width="@(BlazorArcade.GameLogic.EggerlandGame.Width * 40)" height="8" fill="#4a4e69" />

        <!-- 2. Pushable Emerald Blocks Layer -->
        @foreach (var block in GameInstance.Blocks)
        {
            double bx = block.AnimX * 40;
            double by = block.AnimY * 40;

            if (block.IsInWater)
            {
                <!-- Block submerged in water acting as bridge -->
                <rect x="@(bx + 4)" y="@(by + 4)" width="32" height="32" rx="4" fill="#2d6a4f" opacity="0.8" stroke="#52b788" stroke-width="2" />
            }
            else
            {
                <!-- Active Emerald Frame Block -->
                <rect x="@(bx + 2)" y="@(by + 2)" width="36" height="36" rx="6" fill="url(#block-grad)" stroke="#74c69d" stroke-width="2" />
                <rect x="@(bx + 8)" y="@(by + 8)" width="24" height="24" rx="3" fill="none" stroke="#d8f3dc" stroke-width="1.5" opacity="0.6" />
            }
        }

        <!-- 3. Eggs Layer -->
        @foreach (var egg in GameInstance.Eggs)
        {
            if (egg.IsBlastedOff) continue;

            double ex = egg.AnimX * 40;
            double ey = egg.AnimY * 40;

            <g transform="translate(@ex, @ey)">
                <!-- Egg Shell -->
                <ellipse cx="20" cy="22" rx="14" ry="16" fill="#f72585" stroke="#ffffff" stroke-width="2" />
                <ellipse cx="16" cy="18" rx="3" ry="4" fill="#7209b7" opacity="0.6" />
                <ellipse cx="24" cy="24" rx="2" ry="3" fill="#7209b7" opacity="0.6" />
                
                @if (egg.HatchTimer < 4.0)
                {
                    <!-- Crack lines indicating imminent hatching -->
                    <path d="M 16 14 L 20 20 L 24 16 L 22 26" stroke="#ffffff" stroke-width="1.5" fill="none" />
                }

                @if (egg.IsInWater)
                {
                    <!-- Water Ripples -->
                    <circle cx="20" cy="30" r="16" fill="none" stroke="#48cae4" stroke-width="2" opacity="0.8" />
                }
            </g>
        }

        <!-- 4. Monsters Layer -->
        @foreach (var m in GameInstance.Monsters)
        {
            double mx = m.AnimX * 40;
            double my = m.AnimY * 40;

            <g transform="translate(@mx, @my)">
                @switch (m.Type)
                {
                    case BlazorArcade.GameLogic.MonsterType.Snakey:
                        <!-- Snakey -->
                        <path d="M 10 32 C 10 20 30 20 30 32" fill="none" stroke="#38b000" stroke-width="8" stroke-linecap="round" />
                        <circle cx="20" cy="16" r="8" fill="#70e000" />
                        <circle cx="17" cy="14" r="2" fill="#000" />
                        <circle cx="23" cy="14" r="2" fill="#000" />
                        <path d="M 20 20 L 20 24 L 22 25" stroke="#d00000" stroke-width="1.5" fill="none" />
                        break;

                    case BlazorArcade.GameLogic.MonsterType.Alma:
                        <!-- Alma -->
                        <circle cx="20" cy="20" r="16" fill="#ff4d6d" stroke="#c9184a" stroke-width="2" />
                        <circle cx="14" cy="16" r="4" fill="#fff" />
                        <circle cx="26" cy="16" r="4" fill="#fff" />
                        <circle cx="14" cy="16" r="2" fill="#000" />
                        <circle cx="26" cy="16" r="2" fill="#000" />
                        <path d="M 12 26 Q 20 32 28 26" fill="none" stroke="#800f2f" stroke-width="2" />
                        break;

                    case BlazorArcade.GameLogic.MonsterType.Leeper:
                        <!-- Leeper -->
                        <rect x="6" y="8" width="28" height="26" rx="8" fill="@(m.IsSleeping ? "#808080" : "#ffb703")" stroke="#fb8500" stroke-width="2" />
                        @if (m.IsSleeping)
                        {
                            <g><text x="20" y="24" fill="#fff" font-size="14" font-weight="bold" text-anchor="middle">Zzz</text></g>
                        }
                        else
                        {
                            <circle cx="14" cy="18" r="3" fill="#000" />
                            <circle cx="26" cy="18" r="3" fill="#000" />
                            <polygon points="20,24 16,28 24,28" fill="#d00000" />
                        }
                        break;

                    case BlazorArcade.GameLogic.MonsterType.Skull:
                        <!-- Skull -->
                        <rect x="8" y="6" width="24" height="22" rx="10" fill="#f8f9fa" stroke="#adb5bd" stroke-width="2" />
                        <rect x="12" y="26" width="16" height="8" rx="2" fill="#e9ecef" />
                        <circle cx="14" cy="16" r="4" fill="#212529" />
                        <circle cx="26" cy="16" r="4" fill="#212529" />
                        <polygon points="20,20 18,24 22,24" fill="#212529" />
                        break;

                    case BlazorArcade.GameLogic.MonsterType.Gol:
                        <!-- Gol Dragon -->
                        <ellipse cx="20" cy="22" rx="15" ry="14" fill="#38b000" stroke="#007200" stroke-width="2" />
                        @if (m.IsAwake)
                        {
                            <circle cx="14" cy="16" r="4" fill="#ff0000" />
                            <circle cx="26" cy="16" r="4" fill="#ff0000" />
                            <circle cx="20" cy="28" r="6" fill="#ffba08" />
                        }
                        else
                        {
                            <line x1="10" y1="16" x2="18" y2="16" stroke="#000" stroke-width="2" />
                            <line x1="22" y1="16" x2="30" y2="16" stroke="#000" stroke-width="2" />
                        }
                        break;

                    case BlazorArcade.GameLogic.MonsterType.Medusa:
                        <!-- Medusa Mask -->
                        <rect x="6" y="6" width="28" height="28" rx="6" fill="#6c757d" stroke="#343a40" stroke-width="2" />
                        <circle cx="14" cy="16" r="4" fill="#d00000" />
                        <circle cx="26" cy="16" r="4" fill="#d00000" />
                        <polygon points="20,20 16,28 24,28" fill="#343a40" />
                        break;

                    case BlazorArcade.GameLogic.MonsterType.DonMedusa:
                        <!-- Don Medusa -->
                        <rect x="6" y="6" width="28" height="28" rx="6" fill="#7209b7" stroke="#3a0ca3" stroke-width="2" />
                        <circle cx="14" cy="16" r="4" fill="#f72585" />
                        <circle cx="26" cy="16" r="4" fill="#f72585" />
                        <line x1="10" y1="26" x2="30" y2="26" stroke="#4cc9f0" stroke-width="3" />
                        break;
                }
            </g>
        }

        <!-- 5. Projectiles Layer (Magic Shots & Fireballs) -->
        @foreach (var shot in GameInstance.Shots)
        {
            double sx = shot.X * 40 + 20;
            double sy = shot.Y * 40 + 20;

            if (shot.IsFromPlayer)
            {
                <!-- Magic Shot Star/Orb -->
                <circle cx="@sx" cy="@sy" r="8" fill="#4cc9f0" stroke="#ffffff" stroke-width="2" />
                <circle cx="@sx" cy="@sy" r="4" fill="#ffffff" />
            }
            else
            {
                <!-- Fireball -->
                <circle cx="@sx" cy="@sy" r="9" fill="#d00000" stroke="#ffba08" stroke-width="2" />
                <circle cx="@sx" cy="@sy" r="4" fill="#ffba08" />
            }
        }

        <!-- 6. Lolo Hero Player Layer -->
        <g transform="translate(@(GameInstance.Player.AnimX * 40), @(GameInstance.Player.AnimY * 40))">
            <!-- Lolo Body Sphere -->
            <circle cx="20" cy="20" r="16" fill="url(#lolo-grad)" stroke="#ffffff" stroke-width="2" />

            <!-- Lolo Eyes -->
            @{
                double eyeOffsetX = GameInstance.Player.Facing switch {
                    BlazorArcade.GameLogic.EggerlandDirection.Left => -4,
                    BlazorArcade.GameLogic.EggerlandDirection.Right => 4,
                    _ => 0
                };
                double eyeOffsetY = GameInstance.Player.Facing switch {
                    BlazorArcade.GameLogic.EggerlandDirection.Up => -4,
                    BlazorArcade.GameLogic.EggerlandDirection.Down => 2,
                    _ => 0
                };
            }

            <ellipse cx="@(14 + eyeOffsetX)" cy="@(16 + eyeOffsetY)" rx="4" ry="6" fill="#ffffff" />
            <ellipse cx="@(26 + eyeOffsetX)" cy="@(16 + eyeOffsetY)" rx="4" ry="6" fill="#ffffff" />
            <circle cx="@(14 + eyeOffsetX)" cy="@(17 + eyeOffsetY)" r="2" fill="#000000" />
            <circle cx="@(26 + eyeOffsetX)" cy="@(17 + eyeOffsetY)" r="2" fill="#000000" />

            <!-- Feet -->
            <ellipse cx="12" cy="34" rx="6" ry="3" fill="#ffb703" />
            <ellipse cx="28" cy="34" rx="6" ry="3" fill="#ffb703" />
        </g>

    </svg>

    <!-- On-screen D-Pad & Control Buttons for Touch/Mobile -->
    <div class="touch-controls">
        <div class="dpad">
            <button class="dbtn up" @ontouchstart="@(() => SetTouchDir("up", true))" @ontouchend="@(() => SetTouchDir("up", false))">▲</button>
            <button class="dbtn left" @ontouchstart="@(() => SetTouchDir("left", true))" @ontouchend="@(() => SetTouchDir("left", false))">◀</button>
            <button class="dbtn right" @ontouchstart="@(() => SetTouchDir("right", true))" @ontouchend="@(() => SetTouchDir("right", false))">▶</button>
            <button class="dbtn down" @ontouchstart="@(() => SetTouchDir("down", true))" @ontouchend="@(() => SetTouchDir("down", false))">▼</button>
        </div>
        <div class="action-btns">
            <button class="action-btn shoot" @ontouchstart="@(() => SetTouchDir("shoot", true))" @ontouchend="@(() => SetTouchDir("shoot", false))">⚡ SHOOT</button>
        </div>
    </div>

</div>

<!-- Web Audio Synthesizer Script for Arcade Retro Sound Effects -->
<script>
    window.playEggerlandSound = function (type) {
        try {
            if (!window.audioCtx) {
                window.audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (window.audioCtx.state === 'suspended') {
                window.audioCtx.resume();
            }
            const ctx = window.audioCtx;
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.connect(gain);
            gain.connect(ctx.destination);

            const now = ctx.currentTime;

            if (type === 'step') {
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(160, now);
                osc.frequency.exponentialRampToValueAtTime(80, now + 0.05);
                gain.gain.setValueAtTime(0.1, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.05);
                osc.start(now);
                osc.stop(now + 0.05);
            } else if (type === 'shot') {
                osc.type = 'square';
                osc.frequency.setValueAtTime(600, now);
                osc.frequency.exponentialRampToValueAtTime(200, now + 0.12);
                gain.gain.setValueAtTime(0.2, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.12);
                osc.start(now);
                osc.stop(now + 0.12);
            } else if (type === 'egg') {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(300, now);
                osc.frequency.linearRampToValueAtTime(800, now + 0.15);
                gain.gain.setValueAtTime(0.25, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.15);
                osc.start(now);
                osc.stop(now + 0.15);
            } else if (type === 'heart') {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(523.25, now);
                osc.frequency.setValueAtTime(659.25, now + 0.08);
                osc.frequency.setValueAtTime(783.99, now + 0.16);
                gain.gain.setValueAtTime(0.2, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.25);
                osc.start(now);
                osc.stop(now + 0.25);
            } else if (type === 'chest') {
                osc.type = 'square';
                osc.frequency.setValueAtTime(440, now);
                osc.frequency.setValueAtTime(880, now + 0.1);
                gain.gain.setValueAtTime(0.25, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);
                osc.start(now);
                osc.stop(now + 0.3);
            } else if (type === 'death') {
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(300, now);
                osc.frequency.exponentialRampToValueAtTime(40, now + 0.4);
                gain.gain.setValueAtTime(0.3, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.4);
                osc.start(now);
                osc.stop(now + 0.4);
            } else if (type === 'win') {
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(523.25, now);
                osc.frequency.setValueAtTime(659.25, now + 0.12);
                osc.frequency.setValueAtTime(783.99, now + 0.24);
                osc.frequency.setValueAtTime(1046.50, now + 0.36);
                gain.gain.setValueAtTime(0.3, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.5);
                osc.start(now);
                osc.stop(now + 0.5);
            }
        } catch (e) {
            console.warn('Audio play error:', e);
        }
    };
</script>

