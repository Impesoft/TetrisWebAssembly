@page "/KingsValley"
@using BlazorArcade.GameLogic

<video muted loop id="bg">
    <source src="./css/BGTunnel.mp4" type="video/mp4" />
</video>

<div class="top-controls">
    <button class="arcade-btn" @onclick="@(() => _nav.NavigateTo("/"))">Home</button>
    <button class="arcade-btn" @onclick="RestartStage">Restart</button>
    <button class="arcade-btn" @onclick="GameInstance.TogglePause">@(GameInstance.IsPaused ? "Resume" : "Pause")</button>
</div>

<div class="kv-container">
    <div class="kv-arcade-cabinet" tabindex="0" @ref="GameContainer" @onkeydown="HandleKeyDown" @onkeyup="HandleKeyUp">
        <!-- Arcade Header -->
        <div class="kv-marquee">
            <div class="marquee-title">KING'S VALLEY</div>
            <div class="marquee-sub">EGYPTIAN PYRAMID EXPLORER</div>
        </div>

        <!-- HUD Bar -->
        <div class="kv-hud">
            <div class="hud-item">
                <span class="hud-label">HIGH SCORE</span>
                <span class="hud-value gold">@GameInstance.HighScore.ToString("D6")</span>
            </div>
            <div class="hud-item">
                <span class="hud-label">SCORE</span>
                <span class="hud-value white">@GameInstance.Score.ToString("D6")</span>
            </div>
            <div class="hud-item">
                <span class="hud-label">GEMS</span>
                <span class="hud-value cyan">@GameInstance.GemsRemaining</span>
            </div>
            <div class="hud-item">
                <span class="hud-label">ITEMS</span>
                <span class="hud-value yellow">
                    @(GameInstance.Player.HasPickaxe ? "⛏️ PICK" : "")
                    @(GameInstance.Player.KnivesCount > 0 ? $" 🗡️ x{GameInstance.Player.KnivesCount}" : "")
                    @(!GameInstance.Player.HasPickaxe && GameInstance.Player.KnivesCount == 0 ? "NONE" : "")
                </span>
            </div>
            <div class="hud-item">
                <span class="hud-label">CHAMBER</span>
                <span class="hud-value pink">#@GameInstance.Level</span>
            </div>
            <div class="hud-item">
                <span class="hud-label">LIVES</span>
                <span class="hud-value red">
                    @for (int i = 0; i < GameInstance.Lives; i++)
                    {
                        <span class="life-icon">🤠</span>
                    }
                </span>
            </div>
        </div>

        <!-- Main SVG Game Screen -->
        <div class="kv-screen">
            <svg width="800" height="600" viewBox="0 0 800 600" class="kv-svg">
                <defs>
                    <linearGradient id="bgGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                        <stop offset="0%" stop-color="#140a02" />
                        <stop offset="100%" stop-color="#2a1505" />
                    </linearGradient>

                    <linearGradient id="brickGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#c68a4c" />
                        <stop offset="100%" stop-color="#7a4f21" />
                    </linearGradient>

                    <linearGradient id="digGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#8b5a2b" />
                        <stop offset="100%" stop-color="#4a2e12" />
                    </linearGradient>

                    <filter id="goldGlow">
                        <feDropShadow dx="0" dy="0" stdDeviation="3" flood-color="#ffd700" flood-opacity="0.8" />
                    </filter>
                    <filter id="cyanGlow">
                        <feDropShadow dx="0" dy="0" stdDeviation="3" flood-color="#00f5d4" flood-opacity="0.8" />
                    </filter>
                </defs>

                <!-- Background Wall -->
                <rect x="0" y="0" width="800" height="600" fill="url(#bgGradient)" />

                <!-- Hieroglyph Wall Patterns -->
                <g opacity="0.08" stroke="#ffd700" stroke-width="1.5" fill="none">
                    <path d="M 50 100 L 70 80 L 90 100 Z M 70 100 L 70 130" />
                    <circle cx="200" cy="150" r="15" />
                    <path d="M 400 200 L 420 180 L 440 200 Z" />
                    <path d="M 650 120 C 650 90, 700 90, 700 120 Z" />
                </g>

                <!-- Render Tilemap Grid (Walls, Bricks, Ladders, Stairs) -->
                @for (int r = 0; r < KingsValleyGame.Rows; r++)
                {
                    @for (int c = 0; c < KingsValleyGame.Cols; c++)
                    {
                        double x = c * KingsValleyGame.TileSize;
                        double y = r * KingsValleyGame.TileSize;
                        int tile = GameInstance.Grid[r, c];

                        if (tile == 1)
                        {
                            <!-- Solid Sandstone Brick Wall -->
                            <rect x="@x" y="@y" width="40" height="40" fill="url(#brickGrad)" stroke="#3a220c" stroke-width="2" rx="2" />
                            <line x1="@x" y1="@(y + 20)" x2="@(x + 40)" y2="@(y + 20)" stroke="#3a220c" stroke-width="1.5" />
                            <line x1="@(x + 20)" y1="@y" x2="@(x + 20)" y2="@(y + 20)" stroke="#3a220c" stroke-width="1" />
                            <line x1="@(x + 10)" y1="@(y + 20)" x2="@(x + 10)" y2="@(y + 40)" stroke="#3a220c" stroke-width="1" />
                        }
                        else if (tile == 2)
                        {
                            <!-- Diggable Soft Floor Brick -->
                            <rect x="@x" y="@y" width="40" height="40" fill="url(#digGrad)" stroke="#ffaa55" stroke-width="1.5" rx="3" />
                            <circle cx="@(x + 10)" cy="@(y + 10)" r="3" fill="#ffaa55" opacity="0.6" />
                            <circle cx="@(x + 30)" cy="@(y + 25)" r="3" fill="#ffaa55" opacity="0.6" />
                        }
                        else if (tile == 3)
                        {
                            <!-- Ladder -->
                            <g stroke="#00f5d4" stroke-width="2.5">
                                <line x1="@(x + 8)" y1="@y" x2="@(x + 8)" y2="@(y + 40)" />
                                <line x1="@(x + 32)" y1="@y" x2="@(x + 32)" y2="@(y + 40)" />
                                <line x1="@(x + 8)" y1="@(y + 10)" x2="@(x + 32)" y2="@(y + 10)" stroke-width="2" />
                                <line x1="@(x + 8)" y1="@(y + 25)" x2="@(x + 32)" y2="@(y + 25)" stroke-width="2" />
                            </g>
                        }
                        else if (tile == 4)
                        {
                            <!-- Stair Up-Left -->
                            <g stroke="#ffd700" stroke-width="3">
                                <line x1="@(x + 40)" y1="@(y + 40)" x2="@x" y2="@y" />
                                <line x1="@(x + 30)" y1="@(y + 30)" x2="@(x + 40)" y2="@(y + 30)" stroke-width="2" />
                                <line x1="@(x + 15)" y1="@(y + 15)" x2="@(x + 25)" y2="@(y + 15)" stroke-width="2" />
                            </g>
                        }
                        else if (tile == 5)
                        {
                            <!-- Stair Up-Right -->
                            <g stroke="#ffd700" stroke-width="3">
                                <line x1="@x" y1="@(y + 40)" x2="@(x + 40)" y2="@y" />
                                <line x1="@(x + 10)" y1="@(y + 30)" x2="@x" y2="@(y + 30)" stroke-width="2" />
                                <line x1="@(x + 25)" y1="@(y + 15)" x2="@(x + 15)" y2="@(y + 15)" stroke-width="2" />
                            </g>
                        }
                    }
                }

                <!-- Exit Door -->
                <g transform="translate(@GameInstance.ExitDoorPos.X, @GameInstance.ExitDoorPos.Y)">
                    <rect x="0" y="0" width="36" height="48" fill="#1a0d04" stroke="@(GameInstance.IsExitUnlocked ? "#00f5d4" : "#ff3366")" stroke-width="3" rx="4" filter="@(GameInstance.IsExitUnlocked ? "url(#cyanGlow)" : "")" />
                    <path d="M 6 48 L 6 16 C 6 6, 30 6, 30 16 L 30 48" fill="@(GameInstance.IsExitUnlocked ? "#00f5d4" : "#4a1220")" opacity="0.8" />
                    <circle cx="24" cy="28" r="3" fill="#ffd700" />
                    @if (GameInstance.IsExitUnlocked)
                    {
                        <g>
                            @((MarkupString)"<text x=\"18\" y=\"24\" fill=\"#ffffff\" font-size=\"10\" font-weight=\"bold\" text-anchor=\"middle\">EXIT</text>")
                        </g>
                    }
                </g>

                <!-- Collectible Items (Gems, Pickaxes, Knives) -->
                @foreach (var item in GameInstance.Items.Where(i => !i.IsCollected))
                {
                    <g transform="translate(@item.X, @item.Y)">
                        @if (item.Type == "Gem")
                        {
                            <polygon points="12,0 24,10 18,24 6,24 0,10" fill="@item.Color" stroke="#ffffff" stroke-width="1.5" filter="url(#goldGlow)" />
                        }
                        else if (item.Type == "Pickaxe")
                        {
                            <path d="M 2 4 C 10 -2 20 2 24 10 L 20 14 C 16 8 8 6 2 4 Z" fill="#c0c0c0" stroke="#000000" stroke-width="1" />
                            <line x1="12" y1="8" x2="2" y2="24" stroke="#8b4513" stroke-width="3.5" stroke-linecap="round" />
                        }
                        else if (item.Type == "Knife")
                        {
                            <polygon points="2,12 18,4 22,12 18,20" fill="#e0e0e0" stroke="#000000" stroke-width="1" />
                            <rect x="0" y="10" width="6" height="4" fill="#8b4513" />
                        }
                    </g>
                }

                <!-- Flying Thrown Knives -->
                @foreach (var proj in GameInstance.Projectiles)
                {
                    <g transform="translate(@proj.X, @proj.Y)">
                        <polygon points="0,4 12,0 16,4 12,8" fill="#00ffff" stroke="#ffffff" stroke-width="1" filter="url(#cyanGlow)" />
                    </g>
                }

                <!-- Mummy Enemies -->
                @foreach (var m in GameInstance.Mummies)
                {
                    <g transform="translate(@m.X, @m.Y)">
                        @if (m.IsStunned)
                        {
                            <!-- Stunned / Fallen Mummy -->
                            <rect x="0" y="18" width="30" height="14" fill="#d3d3d3" stroke="#000000" stroke-width="1.5" rx="3" />
                            @((MarkupString)"<text x=\"15\" y=\"12\" fill=\"#ffff00\" font-size=\"12\" font-weight=\"bold\" text-anchor=\"middle\">💫</text>")
                        }
                        else
                        {
                            <!-- Walking Mummy -->
                            <rect x="5" y="6" width="16" height="24" fill="@m.Color" stroke="#000000" stroke-width="1.5" rx="3" />
                            <!-- Bandage Wraps -->
                            <line x1="5" y1="12" x2="21" y2="12" stroke="#888888" stroke-width="1.5" />
                            <line x1="5" y1="18" x2="21" y2="18" stroke="#888888" stroke-width="1.5" />
                            <line x1="5" y1="24" x2="21" y2="24" stroke="#888888" stroke-width="1.5" />
                            <!-- Glowing Red Eyes -->
                            <circle cx="@(m.Direction == 1 ? 16 : 8)" cy="10" r="2" fill="#ff0000" />
                            <circle cx="@(m.Direction == 1 ? 19 : 11)" cy="10" r="2" fill="#ff0000" />
                        }
                    </g>
                }

                <!-- Player Explorer (Vick) -->
                <g transform="translate(@GameInstance.Player.X, @GameInstance.Player.Y)">
                    <!-- Explorer Hat -->
                    <path d="M 0 8 L 26 8 L 21 0 L 5 0 Z" fill="#8b4513" stroke="#4a240a" stroke-width="1" />
                    <!-- Head & Face -->
                    <rect x="5" y="8" width="16" height="10" fill="#ffccaa" rx="2" />
                    <circle cx="@(GameInstance.Player.FacingLeft ? 8 : 18)" cy="12" r="1.5" fill="#000000" />
                    <!-- Shirt & Vest -->
                    <rect x="4" y="18" width="18" height="10" fill="#d2b48c" stroke="#5c4033" stroke-width="1" />
                    <rect x="7" y="18" width="12" height="10" fill="#4682b4" />
                    <!-- Pants & Boots -->
                    <rect x="6" y="28" width="6" height="4" fill="#5c4033" />
                    <rect x="14" y="28" width="6" height="4" fill="#5c4033" />
                    <!-- Pickaxe in Hand -->
                    @if (GameInstance.Player.HasPickaxe)
                    {
                        <path d="M @(GameInstance.Player.FacingLeft ? -6 : 22) 14 L @(GameInstance.Player.FacingLeft ? 2 : 30) 6" stroke="#c0c0c0" stroke-width="3" />
                    }
                </g>

                <!-- Floating Score Popups -->
                @foreach (var pop in GameInstance.ScorePopups)
                {
                    @((MarkupString)$"<text x=\"{pop.X}\" y=\"{pop.Y}\" fill=\"#ffd700\" font-size=\"14\" font-weight=\"900\" text-anchor=\"middle\" filter=\"url(#goldGlow)\">+{pop.Points}</text>")
                }

                <!-- Overlays -->
                @if (GameInstance.IsGameOver)
                {
                    <rect x="150" y="200" width="500" height="200" fill="rgba(20, 10, 2, 0.95)" stroke="#ff3366" stroke-width="4" rx="10" />
                    @((MarkupString)"<text x=\"400\" y=\"260\" fill=\"#ff3366\" font-size=\"36\" font-weight=\"900\" text-anchor=\"middle\">GAME OVER</text>")
                    @((MarkupString)"<text x=\"400\" y=\"300\" fill=\"#ffffff\" font-size=\"18\" text-anchor=\"middle\">THE MUMMIES CLAIMED THE TOMB!</text>")
                    <g transform="translate(300, 330)" class="btn-group">
                        <rect x="0" y="0" width="200" height="45" fill="#ff3366" rx="8" cursor="pointer" @onclick="StartGame" />
                        @((MarkupString)"<text x=\"400\" y=\"358\" fill=\"#ffffff\" font-size=\"16\" font-weight=\"bold\" text-anchor=\"middle\">TRY AGAIN</text>")
                    </g>
                }
                else if (GameInstance.IsGameWon)
                {
                    <rect x="150" y="200" width="500" height="200" fill="rgba(20, 10, 2, 0.95)" stroke="#00f5d4" stroke-width="4" rx="10" />
                    @((MarkupString)"<text x=\"400\" y=\"260\" fill=\"#00f5d4\" font-size=\"36\" font-weight=\"900\" text-anchor=\"middle\">CHAMBER CLEARED!</text>")
                    @((MarkupString)"<text x=\"400\" y=\"300\" fill=\"#ffd700\" font-size=\"18\" text-anchor=\"middle\">BONUS SCORE: +1000</text>")
                    <g transform="translate(300, 330)" class="btn-group">
                        <rect x="0" y="0" width="200" height="45" fill="#00f5d4" rx="8" cursor="pointer" @onclick="NextStage" />
                        @((MarkupString)"<text x=\"400\" y=\"358\" fill=\"#140a02\" font-size=\"16\" font-weight=\"bold\" text-anchor=\"middle\">NEXT CHAMBER</text>")
                    </g>
                }
                else if (GameInstance.IsPaused)
                {
                    <rect x="250" y="220" width="300" height="160" fill="rgba(0, 0, 0, 0.85)" stroke="#ffd700" stroke-width="3" rx="10" />
                    @((MarkupString)"<text x=\"400\" y=\"300\" fill=\"#ffd700\" font-size=\"32\" font-weight=\"900\" text-anchor=\"middle\">PAUSED</text>")
                }
            </svg>
        </div>

        <!-- Controls Bar -->
        <div class="kv-controls-panel">
            <div class="dpad-box">
                <button class="dpad-btn up" @onmousedown="() => SetMoveUp(true)" @onmouseup="() => SetMoveUp(false)">▲</button>
                <div class="dpad-row">
                    <button class="dpad-btn left" @onmousedown="() => SetMoveLeft(true)" @onmouseup="() => SetMoveLeft(false)">◄</button>
                    <button class="dpad-btn right" @onmousedown="() => SetMoveRight(true)" @onmouseup="() => SetMoveRight(false)">►</button>
                </div>
                <button class="dpad-btn down" @onmousedown="() => SetMoveDown(true)" @onmouseup="() => SetMoveDown(false)">▼</button>
            </div>

            <div class="action-box">
                <button class="act-btn jump" @onmousedown="() => SetJump(true)" @onmouseup="() => SetJump(false)">JUMP (Space)</button>
                <button class="act-btn dig" @onclick="TriggerDig">⛏️ DIG (K)</button>
                <button class="act-btn throw" @onclick="TriggerThrow">🗡️ THROW (L)</button>
            </div>
        </div>
    </div>
</div>
