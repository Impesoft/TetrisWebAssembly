@page "/BubbleShooter"
@using System.Globalization
@inject NavigationManager _nav

<video muted loop autoplay id="bg">
    <source src="./css/BGTunnel.mp4" type="video/mp4" />
</video>

<div class="bubble-game-wrapper" @ref="_gameContainer" tabindex="0" @onkeydown="OnKeyDown">
    <!-- Controls Header -->
    <div class="controls">
        <button class="arcade-btn" @onclick="@(() => _nav.NavigateTo("/"))">🎮 Home</button>
        @if (IsPaused && !IsGameOver && !IsGameWon)
        {
            <button class="arcade-btn primary" @onclick="StartGame">▶️ Start</button>
        }
        else if (!IsPaused)
        {
            <button class="arcade-btn danger" @onclick="PauseGame">⏸️ Pause</button>
        }
        <button class="arcade-btn warning" @onclick="ResetGame">🔄 Restart</button>
    </div>

    <!-- Stats Bar -->
    <div class="bubble-stats">
        <div class="stat-box">
            <span class="stat-label">SCORE</span>
            <span class="stat-value">@Score</span>
        </div>
        <div class="stat-box">
            <span class="stat-label">LEVEL</span>
            <span class="stat-value">@Level</span>
        </div>
        <div class="stat-box">
            <span class="stat-label">HIGH SCORE</span>
            <span class="stat-value">@HighScore</span>
        </div>
        <div class="stat-box preview-box">
            <span class="stat-label">NEXT</span>
            <svg width="30" height="30" viewBox="0 0 40 40">
                <circle cx="20" cy="20" r="16" fill="@NextBubbleColor" stroke="#fff" stroke-width="2" />
                <circle cx="15" cy="15" r="4" fill="#ffffff" opacity="0.6" />
            </svg>
        </div>
        <div class="stat-box drop-warning">
            <span class="stat-label">DROP IN</span>
            <span class="stat-value highlight">@ShotsUntilCeilingDrop</span>
        </div>
    </div>

    <!-- Main SVG Game Field -->
    <div class="bubble-field-container" @onmousemove="OnMouseMove" @onclick="ShootBubble">
        <svg class="bubble-svg-field" viewBox="0 0 @FieldWidth @FieldHeight" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <!-- Glow & Shadow Filters -->
                <filter id="bubble-glow" x="-20%" y="-20%" width="140%" height="140%">
                    <feGaussianBlur stdDeviation="3" result="blur" />
                    <feComposite in="SourceGraphic" in2="blur" operator="over" />
                </filter>
                <linearGradient id="launcher-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#00f2fe" />
                    <stop offset="100%" stop-color="#4facfe" />
                </linearGradient>
            </defs>

            <!-- Background Grid Pattern / Field Border -->
            <rect x="0" y="0" width="@FieldWidth" height="@FieldHeight" fill="#0d0e23" opacity="0.85" rx="12" stroke="#3a3d68" stroke-width="3" />

            <!-- Deadline Warning Line -->
            <line x1="0" y1="@FormatDouble(DeadlineY)" x2="@FieldWidth" y2="@FormatDouble(DeadlineY)" stroke="#ff3366" stroke-width="2" stroke-dasharray="8 6" opacity="0.75" />
            <text x="10" y="@FormatDouble(DeadlineY - 6)" fill="#ff3366" font-size="12" font-family="monospace" opacity="0.8">DANGER ZONE</text>

            <!-- Aiming Laser Trajectory Line -->
            @if (!IsPaused && ActiveBubble == null && TrajectoryPoints.Count > 1)
            {
                <polyline points="@(string.Join(" ", TrajectoryPoints.Select(p => $"{FormatDouble(p.X)},{FormatDouble(p.Y)}")))"
                          fill="none"
                          stroke="#00ffff"
                          stroke-width="3"
                          stroke-dasharray="6 6"
                          stroke-linecap="round"
                          opacity="0.85" />
            }

            <!-- Board Grid Bubbles -->
            @for (int r = 0; r < MaxRows; r++)
            {
                int colsInRow = GetMaxCols(r);
                for (int c = 0; c < colsInRow; c++)
                {
                    var cell = Board[r, c];
                    if (cell != null)
                    {
                        var pos = GetCellCenter(r, c);
                        <g class="bubble-node">
                            <circle cx="@FormatDouble(pos.X)" cy="@FormatDouble(pos.Y)" r="@FormatDouble(BubbleRadius)" fill="@cell.Color" stroke="#ffffff" stroke-width="1.5" />
                            <!-- 3D Specular Highlight -->
                            <circle cx="@FormatDouble(pos.X - 6)" cy="@FormatDouble(pos.Y - 6)" r="5" fill="#ffffff" opacity="0.55" />
                        </g>
                    }
                }
            }

            <!-- Active Flying Bubble -->
            @if (ActiveBubble != null)
            {
                <g class="active-bubble">
                    <circle cx="@FormatDouble(ActiveBubble.X)" cy="@FormatDouble(ActiveBubble.Y)" r="@FormatDouble(BubbleRadius)" fill="@ActiveBubble.Color" stroke="#ffffff" stroke-width="2" filter="url(#bubble-glow)" />
                    <circle cx="@FormatDouble(ActiveBubble.X - 6)" cy="@FormatDouble(ActiveBubble.Y - 6)" r="5" fill="#ffffff" opacity="0.6" />
                </g>
            }

            <!-- Falling Unanchored Bubbles -->
            @foreach (var drop in DroppingBubbles)
            {
                <g class="falling-bubble">
                    <circle cx="@FormatDouble(drop.X)" cy="@FormatDouble(drop.Y)" r="@FormatDouble(BubbleRadius)" fill="@drop.Color" stroke="#ffffff" stroke-width="1" opacity="0.8" />
                    <circle cx="@FormatDouble(drop.X - 5)" cy="@FormatDouble(drop.Y - 5)" r="4" fill="#ffffff" opacity="0.5" />
                </g>
            }

            <!-- Pop Score Effects -->
            @foreach (var pop in PopEffects)
            {
                <g class="pop-effect" opacity="@FormatDouble(pop.Life)">
                    <circle cx="@FormatDouble(pop.X)" cy="@FormatDouble(pop.Y)" r="@FormatDouble(BubbleRadius * (1.8 - pop.Life))" fill="none" stroke="@pop.Color" stroke-width="3" />
                    <text x="@FormatDouble(pop.X)" y="@FormatDouble(pop.Y + 4)" fill="#ffffff" font-weight="bold" font-size="16" text-anchor="middle" font-family="sans-serif">@pop.PointsText</text>
                </g>
            }

            <!-- Launcher Cannon -->
            <g class="cannon-group">
                <!-- Base Rotator Barrel -->
                <line x1="@FormatDouble(LauncherX)" y1="@FormatDouble(LauncherY)"
                      x2="@FormatDouble(LauncherX + Math.Cos(AimAngle) * 45)" y2="@FormatDouble(LauncherY + Math.Sin(AimAngle) * 45)"
                      stroke="url(#launcher-grad)" stroke-width="12" stroke-linecap="round" />

                <!-- Base Ring -->
                <circle cx="@FormatDouble(LauncherX)" cy="@FormatDouble(LauncherY)" r="28" fill="#1e2246" stroke="#00f2fe" stroke-width="3" />

                <!-- Current Cannon Bubble Ready to Fire -->
                @if (ActiveBubble == null)
                {
                    <circle cx="@FormatDouble(LauncherX)" cy="@FormatDouble(LauncherY)" r="@FormatDouble(BubbleRadius)" fill="@CurrentBubbleColor" stroke="#ffffff" stroke-width="2" />
                    <circle cx="@FormatDouble(LauncherX - 6)" cy="@FormatDouble(LauncherY - 6)" r="5" fill="#ffffff" opacity="0.6" />
                }
            </g>
        </svg>

        <!-- Overlay Modals -->
        @if (IsPaused && !IsGameOver && !IsGameWon)
        {
            <div class="overlay-card">
                <h2>BUBBLE SHOOTER</h2>
                <p>Aim with mouse or Left/Right arrows. Click or press Spacebar to fire!</p>
                <button class="arcade-btn primary lg" @onclick="StartGame">PLAY NOW</button>
            </div>
        }
        else if (IsGameOver)
        {
            <div class="overlay-card danger">
                <h2>GAME OVER</h2>
                <p>Final Score: <strong>@Score</strong></p>
                <button class="arcade-btn primary lg" @onclick="ResetGame">TRY AGAIN</button>
            </div>
        }
        else if (IsGameWon)
        {
            <div class="overlay-card success">
                <h2>LEVEL CLEARED! 🎉</h2>
                <p>Score: <strong>@Score</strong></p>
                <button class="arcade-btn primary lg" @onclick="NextLevel">NEXT LEVEL 🚀</button>
            </div>
        }
    </div>
</div>
