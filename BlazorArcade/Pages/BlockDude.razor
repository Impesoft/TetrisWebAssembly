@page "/BlockDude"
@using BlazorArcade.GameLogic

<div class="blockdude-container" tabindex="0" @ref="_gameContainer" @onkeydown="HandleKeyDown" autofocus>


    <div class="game-header">
        <h2>Block Dude</h2>
        <div class="controls">
            <span>Level: @(_game.CurrentLevel + 1)</span>
            <button @onclick="ResetLevel">Restart (R)</button>
            <button class="menu-btn" @onclick="GoHome">Back to Menu</button>
        </div>
    </div>

    @if (_game.GameComplete)
    {
        <div class="game-complete-overlay">
            <h2>Congratulations!</h2>
            <p>You beat all levels!</p>
            <button @onclick="RestartGame">Play Again</button>
            <button @onclick="GoHome">Menu</button>
        </div>
    }
    else
    {
        <div class="game-board" style="width: 100%; max-width: @(_game.Width * TileSize)px; aspect-ratio: @(_game.Width) / @(_game.Height);">
            @if (_game.Map != null)
            {
                @for (int y = 0; y < _game.Height; y++)
                {
                    @for (int x = 0; x < _game.Width; x++)
                    {
                        if (_game.Map[x, y] == 1)
                        {
                            <div class="wall" style="left: @((double)x / _game.Width * 100)%; top: @((double)y / _game.Height * 100)%; width: @(100.0 / _game.Width)%; height: @(100.0 / _game.Height)%;"></div>
                        }
                        else if (_game.Map[x, y] == 3)
                        {
                            <div class="door" style="left: @((double)x / _game.Width * 100)%; top: @((double)y / _game.Height * 100)%; width: @(100.0 / _game.Width)%; height: @(100.0 / _game.Height)%;"></div>
                        }
                    }
                }
            }

            @if (_game.Blocks != null)
            {
                @foreach (var block in _game.Blocks)
                {
                    <div class="block" @key="block.Id" style="left: @(block.RenderX / _game.Width * 100)%; top: @(block.RenderY / _game.Height * 100)%; width: @(100.0 / _game.Width)%; height: @(100.0 / _game.Height)%;"></div>
                }
            }

            @if (_game.Player != null)
            {
                <div class="player @(_game.Player.FacingLeft ? "facing-left" : "") @(_game.Player.IsCarryingBlock ? "carrying" : "")" 
                     style="left: @(_game.Player.RenderX / _game.Width * 100)%; top: @(_game.Player.RenderY / _game.Height * 100)%; width: @(100.0 / _game.Width)%; height: @(100.0 / _game.Height)%;">
                    <div class="player-sprite"></div>
                    @if (_game.Player.IsCarryingBlock)
                    {
                        <div class="carried-block" style="width: 100%; height: 100%; top: -100%;"></div>
                    }
                </div>
            }

            @if (_game.LevelComplete)
            {
                <div class="level-complete-overlay">
                    <h3>Level Complete!</h3>
                    <button @onclick="NextLevel">Next Level (Space)</button>
                </div>
            }

            @if (!IsGameStarted)
            {
                <div class="game-over-overlay" style="z-index: 1000; position: absolute; inset: 0; background: rgba(0,0,0,0.8); display: flex; flex-direction: column; justify-content: center; align-items: center;">
                    <h2 style="color: white; margin-bottom: 20px; font-family: 'Press Start 2P', monospace;">Block Dude</h2>
                    <button class="btn btn-primary" style="padding: 10px 20px; font-size: 1.2rem; cursor: pointer;" @onclick="StartGame">Start Game</button>
                </div>
            }
        </div>
    }

    <!-- Mobile Touch Controls -->
    @if (IsGameStarted && !_game.GameComplete)
    {
        <div class="mobile-controls" style="display: flex; justify-content: center; gap: 20px; margin-top: 20px; width: 100%; max-width: 400px; z-index: 10;">
            <button style="padding: 15px 30px; font-size: 1.5rem; background: rgba(255,255,255,0.2); border: 2px solid white; border-radius: 10px;" @onpointerdown="TouchLeft" @onclick:preventDefault>◀</button>
            <button style="padding: 15px 30px; font-size: 1.5rem; background: rgba(255,255,255,0.2); border: 2px solid white; border-radius: 10px;" @onpointerdown="TouchRight" @onclick:preventDefault>▶</button>
            <button style="padding: 15px 30px; font-size: 1.5rem; background: rgba(255,255,255,0.2); border: 2px solid white; border-radius: 10px;" @onpointerdown="TouchUp" @onclick:preventDefault>⬆ Action</button>
        </div>
    }
</div>

